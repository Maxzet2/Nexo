### Переменные
@server = http://localhost:8080
@modelName = gpt2
@userId = 00000000-0000-0000-0000-000000000001

### Проверка живости → 200 (не проверяет PostgreSQL и Triton)
GET {{server}}/healthy

> {% client.test("Server is alive", function () { client.assert(response.status === 200); }); %}

### Модели в репозитории Triton → 200; состояние READY означает готовность модели
GET {{server}}/model/get-available

> {% client.test("Models are available", function () { client.assert(response.status === 200); }); %}

### Новый чат → 200 (нужны PostgreSQL, Triton и tokenizer.json для выбранной модели)
POST {{server}}/chat/chat/messages
Content-Type: application/json

{
  "userId": "{{userId}}",
  "model": "{{modelName}}",
  "message": "Hello! How are you?",
  "systemPrompt": "You are a helpful assistant."
}

> {%
    client.test("Chat created", function () {
        client.assert(response.status === 200);
        client.assert(!!response.body.chatId);
        client.assert(!!response.body.assistantNodeId);
    });
    if (response.status === 200) client.global.set("createdChatId", response.body.chatId);
%}

### Продолжить чат (сначала выполнить успешное создание выше) → 200
POST {{server}}/chat/chat/messages
Content-Type: application/json

{
  "chatId": "{{createdChatId}}",
  "userId": "{{userId}}",
  "model": "{{modelName}}",
  "message": "Tell me more."
}

> {% client.test("Message sent", function () { client.assert(response.status === 200); }); %}

### Пустое сообщение → 400 invalid_request
POST {{server}}/chat/chat/messages
Content-Type: application/json

{
  "userId": "{{userId}}",
  "model": "{{modelName}}",
  "message": ""
}

> {% client.test("Empty message rejected", function () { client.assert(response.status === 400); client.assert(response.body.code === "invalid_request"); }); %}

### Некорректный UUID → 400 invalid_request
POST {{server}}/chat/chat/messages
Content-Type: application/json

{
  "userId": "not-a-uuid",
  "model": "{{modelName}}",
  "message": "Hello"
}

> {% client.test("Invalid UUID rejected", function () { client.assert(response.status === 400); client.assert(response.body.code === "invalid_request"); }); %}

### Отсутствует обязательное поле message → 400 invalid_request
POST {{server}}/chat/chat/messages
Content-Type: application/json

{
  "userId": "{{userId}}",
  "model": "{{modelName}}"
}

> {% client.test("Missing field rejected", function () { client.assert(response.status === 400); client.assert(response.body.code === "invalid_request"); }); %}

### Несуществующий чат → 404 chat_not_found (нужен PostgreSQL)
POST {{server}}/chat/chat/messages
Content-Type: application/json

{
  "chatId": "00000000-0000-0000-0000-000000000000",
  "userId": "{{userId}}",
  "model": "{{modelName}}",
  "message": "Hello"
}

> {% client.test("Missing chat", function () { client.assert(response.status === 404); client.assert(response.body.code === "chat_not_found"); }); %}

### Несуществующая модель → 404 model_not_found (нужен PostgreSQL)
# Создаёт чат с неудавшимся ответом: история сохраняется согласно текущей бизнес-логике.
POST {{server}}/chat/chat/messages
Content-Type: application/json

{
  "userId": "{{userId}}",
  "model": "no_such_model",
  "message": "Hello"
}

> {% client.test("Missing model", function () { client.assert(response.status === 404); client.assert(response.body.code === "model_not_found"); }); %}
